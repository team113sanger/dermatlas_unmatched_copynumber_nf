
/*
========================================================================================
  Nextflow config file
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// One id names all of a run's artifacts - nextflow log (nextflow-<RUN_ID>.log),
// execution trace (execution_trace-<RUN_ID>.txt) and execution report
// (execution_report-<RUN_ID>.html) - so they can be matched up at a glance.
// The run wrapper computes and exports RUN_ID (label/study_project_cohort plus a
// YYYYMMDDTHHMMSS timestamp); direct `nextflow run` invocations fall back to a
// bare timestamp in the same format.
def run_id = System.getenv('RUN_ID') ?: new java.util.Date().format("yyyyMMdd'T'HHmmss")

// Where this run's execution trace goes. The run wrapper exports TRACE_DIR; System.getenv
// (rather than a "${TRACE_DIR}" interpolation) is used deliberately - an unset variable in a
// Nextflow config string silently becomes the literal '[:]', whereas getenv returns null and
// falls back cleanly here.
def trace_dir  = System.getenv('TRACE_DIR') ?: 'results/pipeline_info'
def trace_path = "${trace_dir}/execution_trace-${run_id}.txt"

includeConfig 'conf/base.config'

// Global default params, used in configs
params {

    // Boilerplate options
    outdir                     = './results'
    tracedir                   = "${params.outdir}/pipeline_info"
    publish_dir_mode           = 'copy'

    // Max requirements
    max_memory                 = '128.GB'
    max_cpus                   = 64
    max_time                   = '240.h'

    // ---- Cohort inputs -------------------------------------------------------------

    // Study identifier, used in the run id and carried on every meta map.
    study_id                   = null

    // Prefix for every sample list, .seg file and plot this run produces (the
    // TUMOUR_TYPE of the original wrapper scripts), e.g. 'Pilar_cyst'. Required.
    cohort_prefix              = null

    // Glob matching the cohort's indexed BAMs and their .bai indexes, e.g.
    // "/path/to/bams/**bam{,.bai}". It must match exactly two files per sample:
    // `**` descends into the per-sample subdirectories and the brace excludes the
    // sibling .bam.bas / .bam.met.gz files.
    bam_path                   = null

    // Tab-delimited metadata manifest for the cohort. An .xlsx manifest is rejected:
    // the pipeline reads the sex column itself to re-call `cn` per sample.
    metadata_manifest          = null

    // The tumours the study has agreed to analyse, one id per line. Decides which of
    // the BAMs matched by bam_path are called at all.
    all_samples                = null

    // Optional list of sample ids to drop entirely, e.g. samples that failed QC.
    // Applied before anything is scheduled, so an excluded sample costs no compute.
    exclude_samples            = null

    // Subcohorts - map of subcohort name to config. Each needs a sample_list; an
    // exclude_list is optional and defaults to the hypersegmented samples this run
    // identified. Example:
    // subcohorts = [
    //     "one_per_patient": [sample_list: "/path/to/one_tumour_per_patient.tsv"],
    //     "all_tumours":     [sample_list: "/path/to/analysed_all_tum.txt"],
    // ]
    subcohorts                 = [:]

    // Metadata manifest column names.
    col_sample_id              = 'Sanger_DNA_ID'
    col_sex                    = 'Sex'
    col_TN                     = 'Phenotype'

    // ---- Reference data ------------------------------------------------------------
    // Site defaults live in the farm22 profile; anything cohort-shaped belongs in the
    // run's own -c config (see assets/unmatched_copynumber.config).

    reference_genome           = null
    reference_genome_index     = null
    baitset_bed                = null
    refflat_file               = null

    // Static files generated alongside the pooled reference. These must be the ones the
    // reference was built from: the .cnn reference is indexed by their bins.
    access_bed                 = null
    targets_bed                = null
    antitargets_bed            = null
    baitset_genes_file         = null

    // Pooled normal reference, in CNVkit .cnn format. Build them with
    // `-entry BUILD_REFERENCE` if a cohort uses a baitset with no reference yet.
    male_reference             = null
    female_reference           = null

    // Contig prefixes dropped from the accessible regions before binning.
    unplaced_contig_prefixes   = ['HLA', 'chrUn', 'chrEBV']

    // BED of blacklisted and problematic regions, subtracted from the accessible
    // regions. Only used by -entry BUILD_REFERENCE.
    sv_blacklist               = null

    // Theoretical log2 ratio thresholds per tumour purity, used to draw the preliminary
    // penetrance plot sweep. Columns: purity, CN0, CN1, CN2, CN3, CN4, CN5.
    purity_log2_table          = null

    // BED of difficult regions; segments overlapping one by at least
    // bed_overlap_threshold are dropped from the filtered arm.
    difficult_regions          = null

    // GISTIC2 reference gene file (.mat).
    gistic_refgene_file        = null

    // ---- Calling -------------------------------------------------------------------

    // Log2 ratio boundaries for CN=0, 1, 3 and 4, passed to `cnvkit call -t`. The
    // default is the theoretical set for a 40%-purity tumour.
    call_thresholds            = '-0.737,-0.322,0.263,0.485'

    // Thresholds to re-call `cn` with once the preliminary penetrance plots have been
    // reviewed. Unset means re-call with call_thresholds, i.e. leave the calls as they
    // are. Everything downstream - the plots, the .seg export and GISTIC2's amplitude
    // cut-offs - is keyed on these.
    recall_thresholds          = null

    // Segments with a CNVkit `weight` below this are dropped during calling. Segments
    // with few or noisy bins are the usual source of spurious focal calls.
    weight_filter_threshold    = 30

    // ---- Filtering -----------------------------------------------------------------

    // A sample whose *average* segment is shorter than this is hypersegmented: its
    // profile is too finely broken up to be scored, and it is excluded from every
    // subcohort by default.
    min_average_segment_size   = 4000000

    // Per-segment filters for the 'filtered' arm. A segment is dropped if it overlaps
    // difficult_regions by at least bed_overlap_threshold of its length, if it is
    // shorter than min_segment_size, or if its weight is below segment_weight.
    bed_overlap_threshold      = 0.6
    min_segment_size           = 400000
    segment_weight             = 30

    // ---- Plots ---------------------------------------------------------------------

    // Y-axis range of the penetrance plots, as "<min> <max>" percentages.
    penetrance_y_range         = '-100 100'

    // ---- GISTIC2 -------------------------------------------------------------------

    gistic_broad_length_cutoff = 0.75
    gistic_confidence_level    = 0.95

    // ---- Reporting -----------------------------------------------------------------

    // Skip status reporting for stub/test runs (accepts true/false/1/0).
    // `-stub-run` on the CLI (workflow.stubRun) is also honoured, so this flag
    // is only needed where that is unavailable.
    is_stub                    = false

    // Run reporting is deliberately kept out of the workflow's params: it is gated by
    // two env-var opt-ins exported by the run wrapper (see
    // assets/run_unmatched_copynumber.sh) and lib/Utils.groovy reads everything it needs
    // (COHORT_SLUG, SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL,
    // RUN_ID) straight from the environment in the onComplete handler:
    //   DERMATLAS_WEBSITE_LOGGING     - record the run via `dermatlas-http cohort
    //                                   analysis-log` (>= 0.6.1).
    //   DERMATLAS_SLACK_NOTIFICATIONS - post a Slack message on completion.
    // The one reporting value that is a param is this pipeline's own slug in the
    // analysis log - pipeline-owned metadata, like the manifest version.
    analysis_pipeline_slug     = 'unmatched-copy-number-pipe'

    // Path of this run's execution trace. Assigned from the same value as trace.file below,
    // so the two can never drift; read by the onComplete handler and attached to the
    // analysis-log record (--nextflow-performance) when website logging is opted in.
    trace_file                 = trace_path

}

profiles {
    secure_lustre {
        process.executor = 'local'

        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }

        singularity {
            enabled    = false
            autoMounts = false
        }
    }

    farm22 {
        process.executor = 'lsf'
        singularity.runOptions = "--bind /lustre"

        process {
            // Sized from the #BSUB directives of the wrapper scripts this pipeline
            // replaces, which is where these numbers were tuned.
            withName: 'CNVKIT_STATIC_FILES' {
                cpus = 1
                memory = '8.GB'
                time = '12h'
            }
            withName: 'CNVKIT_PARAMETER_FILE' {
                cpus = 1
                memory = '4.GB'
                time = '4h'
            }
            withName: 'CNVKIT_POOLED_REFERENCE' {
                // An all-vs-all comparison of the cohort's normals: days, not hours.
                cpus = 60
                memory = '60.GB'
                time = '168h'
                queue = 'week'
            }
            withName: 'CNVKIT_CALL_COPY_NUMBER' {
                cpus = 32
                memory = '20.GB'
                time = '48h'
                queue = 'long'
            }
            withName: 'CNVKIT_RECALL' {
                cpus = 1
                memory = '8.GB'
                time = '1h'
            }
            withName: 'FIND_HYPERSEGMENTED_SAMPLES' {
                cpus = 1
                memory = '1.GB'
                time = '1h'
            }
            withName: 'FILTER_SEGMENTS' {
                cpus = 1
                memory = '4.GB'
                time = '1h'
            }
            withName: 'PENETRANCE_PLOT' {
                cpus = 1
                memory = '4.GB'
                time = '1h'
            }
            withName: 'RUN_GISTIC2' {
                cpus = 4
                memory = '8.GB'
                time = '12h'
            }
        }

        // Site reference data only. Anything project-shaped (output locations, metadata,
        // sample lists and subcohorts) belongs in the run's own -c config, driven by the
        // project source_me.sh - see assets/unmatched_copynumber.config.
        params {
            reference_genome       = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/GRCh38_full_analysis_set_plus_decoy_hla.fa"
            reference_genome_index = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/GRCh38_full_analysis_set_plus_decoy_hla.fa.fai"
            baitset_bed            = "/lustre/scratch127/casm/projects/dermatlas/resources/baitset/GRCh38_WES5_canonical_pad100.merged.bed"
            refflat_file           = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/refFlat.txt"
            sv_blacklist           = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/sv_blacklist.v3.merged.bed"

            access_bed             = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/access-GRCh38_full_analysis_set_plus_decoy_hla.bed"
            targets_bed            = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/GRCh38_WES5_canonical_pad100.merged.target.bed"
            antitargets_bed        = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/GRCh38_WES5_canonical_pad100.merged.antitarget.bed"
            baitset_genes_file     = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/GRCh38_WES5_canonical_pad100.merged.baitset_genes.txt"

            // Built from 25 male and 25 female normals of the hidradenoma cohort
            // (6513_2706) on the WES5 baitset. Valid only for that baitset.
            male_reference         = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/pooled_reference/male/male.reference.cnn"
            female_reference       = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/pooled_reference/female/female.reference.cnn"

            purity_log2_table      = "/lustre/scratch127/casm/projects/dermatlas/resources/unmatched_copynumber/purity_vs_log2ratio.tsv"
            difficult_regions      = "/lustre/scratch127/casm/projects/dermatlas/resources/gistic/gistic2_difficult_regions.bed"
            gistic_refgene_file    = "/lustre/scratch127/casm/projects/dermatlas/resources/gistic/hg38.UCSC.add_miR.160920.refgene.mat"
        }

        docker {
            enabled = false
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = '/lustre/scratch127/casm/projects/dermatlas/singularity_images'
            registry   = 'gitlab-registry.internal.sanger.ac.uk'
        }
        executor {
            name = 'lsf'
            perJobMemLimit = true
            poolSize = 4
            submitRateLimit = '5 sec'
            killBatchSize = 50
        }
    }
}


report {
    enabled = true
    file    = "${params.tracedir}/execution_report-${run_id}.html"
}

trace {
    enabled   = true
    file      = trace_path
    overwrite = false
}


manifest {
    name            = 'dermatlas_unmatched_copynumber_nf'
    author          = 'Kim Wong, Jamie Billington'
    homePage        = 'https://github.com/team113sanger/dermatlas_unmatched_copynumber_nf'
    description     = 'Dermatlas unmatched copy number analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.04.5'
    version         = '0.1.2'
    defaultBranch   = 'develop'
}

// Function to check maximum resources
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
