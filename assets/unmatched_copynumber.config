params {
    // Every projectify location below comes from the project source_me.sh.
    // run_unmatched_copynumber.sh checks these are exported before nextflow is launched -
    // an unset variable is not an error to the config parser, it silently becomes the
    // literal '[:]', so the guard in the wrapper is what catches it.
    outdir            = "${ANALYSIS_DIR}/unmatched_copy_number"
    study_id          = "${STUDY}"
    cohort_prefix     = "${STUDY}_${PROJECT}_${COHORT}"

    // The glob must match the BAM and its .bai and nothing else: `**` descends into the
    // per-sample subdirectories and the brace excludes the sibling .bam.bas /
    // .bam.met.gz files.
    bam_path          = "${BAMS_DIR}/**bam{,.bai}"

    // Sample id, sex and tumour/normal columns for the cohort. Must be TSV, not .xlsx.
    metadata_manifest = "${COHORT_METADATA_FILE}"

    // Every tumour the study has agreed to analyse. Decides which BAMs are called.
    all_samples       = "${DNA_TUMOUR_LIST_ANALYSED_ALL}"

    // The sample lists are generated and versioned by dermanager, so it owns their paths.
    // Each subcohort gets its own filtered segments, .seg file, penetrance plots and
    // GISTIC2 run. Samples found to be hypersegmented are excluded from all of them.
    subcohorts = [
        "independent_tumours": [
            sample_list: "${DNA_TUMOUR_LIST_INDEPENDENT_TUMOURS_ALL}"
        ],
        "one_tumour_per_patient": [
            sample_list: "${DNA_TUMOUR_LIST_ONE_TUMOUR_PER_PATIENT_ALL}"
        ],
        "related_tumours": [
            sample_list: "${DNA_TUMOUR_LIST_RELATED_TUMOURS_ALL}"
        ]
    ]

    // Log2 ratio thresholds for CN=0, 1, 3 and 4, i.e. the purity the calls assume.
    //
    // The default below is the theoretical set for a 40%-purity tumour, and is what
    // CNVkit calls with. Review the preliminary penetrance plots this run publishes to
    // ${outdir}/cnvkit_cn_penetrance_plots - one per purity - and if a different purity
    // fits the cohort better, set recall_thresholds to that row of purity_vs_log2ratio.tsv
    // (its CN0, CN1, CN3 and CN4 columns) and re-run. Everything from the re-called `cn`
    // values to GISTIC2's amplitude cut-offs follows from this one line.
    //
    // recall_thresholds = '-1.000,-0.415,0.322,0.585'   // 50% purity

    // Reference data, the pooled normal reference and the GISTIC2 resources all come
    // from the farm22 profile in the pipeline's own nextflow.config. Override one here
    // only if this cohort uses a baitset other than WES5 - in which case it needs its
    // own pooled reference too, built with `-entry BUILD_REFERENCE`.

    // Run reporting needs no params here: it is gated by the DERMATLAS_WEBSITE_LOGGING /
    // DERMATLAS_SLACK_NOTIFICATIONS env vars exported by run_unmatched_copynumber.sh, and
    // the pipeline's onComplete handler reads the payload values (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL) straight from
    // the environment.
}

// nextflow.config resolves params.tracedir eagerly against the default outdir, so the
// execution report would otherwise land in ./results/pipeline_info relative to the
// launch directory. This block is parsed last, so it wins. RUN_ID (exported by the
// wrapper) keeps the report name in step with the nextflow log and execution trace.
report {
    file = "${ANALYSIS_DIR}/unmatched_copy_number/pipeline_info/execution_report-${System.getenv('RUN_ID') ?: new Date().format("yyyyMMdd'T'HHmmss")}.html"
}
