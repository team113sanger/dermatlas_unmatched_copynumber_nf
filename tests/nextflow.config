/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// Every test runs with -stub, so no task does any real work and none of them needs the
// resources conf/base.config asks for - which are sized for the farm and do not fit on a
// test machine. `withName: '.*'` matches every process and outranks every label, so this
// one block replaces the lot; lowering the check_max() ceilings instead would not, since
// those are read from the binding of the config that defines check_max.
process {
    withName: '.*' {
        cpus   = 1
        memory = '1.GB'
        time   = '10.m'
        queue  = null
    }
}

// No container is pulled: with -stub the script never runs the tool, and the fur-cnvkit
// and GISTIC2 images live in the internal registry, which a test machine may not reach.
docker.enabled = false
singularity.enabled = false
